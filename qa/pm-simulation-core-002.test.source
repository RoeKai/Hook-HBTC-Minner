// PM-authored acceptance cases for ACC-M1-SIM-CORE-002.
// Pending implementation: NOT run, NOT a passing test report.
// Copy into src/core/pm-simulation.test.ts only in an isolated candidate worktree.
import { describe, it, expect } from 'vitest';
import {
  createSimulation, startSimulation, pauseSimulation, resumeSimulation, endSimulation,
  submitIntent, markUnknown, resolveIntent, advanceRound, claimRewards, balances,
} from './simulation';
import { emissionAt, rewardAt } from './accumulation';

const conf = (extra = {}) => ({ id: 'pm-plan', nvdaBudget: 100_000n, ethBudget: 1_000n,
  perRoundCap: 20_000n, costPerThousandCap: 10n ** 30n, ethExitReserve: 100n, maxRounds: 3, ...extra });
const cand = (extra = {}) => ({ id: 'pm-candidate', budget: 10_000n, paid: 9_000n,
  refund: 1_000n, work: 9_000n, gasWei: 100n, claimGasWei: 40n, serviceCostNvda: 10n, ...extra });
const req = (id = 'i1', extra = {}) => ({ id, now: 1_000, candidates: [cand()],
  otherWorkScenarios: [0n], fx: {numerator: 1n, denominator: 1n, observedAt: 1_000,
  maxAgeSeconds: 30, source: 'PM fixture, not a market quote'}, ...extra });
const initial = (extra = {}) => startSimulation(createSimulation(conf(extra)));
const pending = () => submitIntent(initial(), req());
const confirmed = () => resolveIntent(pending(), 'i1', 'success', 70n);
const mature = () => advanceRound(confirmed(), 0n);
function invariant(s: ReturnType<typeof createSimulation>) {
  const b = balances(s);
  expect(b.nvdaSpent + b.nvdaReserved + b.nvdaAvailable).toBe(s.config.nvdaBudget);
  expect(b.ethSpent + b.ethReserved + b.ethAvailable).toBe(s.config.ethBudget);
  expect(b.pointsAvailable + b.pointsReserved + b.pointsSpent).toBe(10);
  expect(b.confirmedReward).toBe(b.claimableReward + b.claimedReward);
  for (const value of Object.values(b)) expect(value >= 0).toBe(true);
}

describe('PM independent simulation conservation', () => {
  it('reserves distinct currencies and service points before confirmation', () => {
    const s = pending(); invariant(s);
    expect(balances(s)).toMatchObject({nvdaSpent: 0n, nvdaReserved: 10_010n, nvdaAvailable: 89_990n,
      ethSpent: 0n, ethReserved: 240n, ethAvailable: 760n, pointsReserved: 1, pointsAvailable: 9,
      pointsSpent: 0, confirmedReward: 0n});
  });
  it('success spends paid not budget, fees once, and reserves claim/exit gas', () => {
    const s = confirmed(); invariant(s);
    expect(balances(s)).toMatchObject({nvdaSpent: 9_010n,nvdaReserved: 0n,nvdaAvailable: 90_990n,
      ethSpent: 70n,ethReserved: 140n,ethAvailable: 790n,pointsAvailable:9,pointsReserved:0,
      pointsSpent:1,confirmedReward:0n});
  });
  it('failure spends only actual failure gas and generates no work rewards', () => {
    let s = resolveIntent(pending(), 'i1', 'failed', 30n); invariant(s);
    expect(balances(s)).toMatchObject({nvdaSpent:0n,nvdaReserved:0n,ethSpent:30n,ethReserved:100n,
      pointsAvailable:10,pointsReserved:0,pointsSpent:0});
    s = advanceRound(s, 0n); invariant(s); expect(balances(s).confirmedReward).toBe(0n);
  });
  it('UNKNOWN holds all reservations until original intent is resolved', () => {
    const p = pending(); const u = markUnknown(p, 'i1'); invariant(u);
    expect(balances(u)).toEqual(balances(p));
    expect(() => advanceRound(u, 0n)).toThrow();
    expect(() => submitIntent(u, req('other'))).toThrow();
    const done = resolveIntent(u, 'i1', 'success',70n); invariant(done);
    expect(balances(done)).toEqual(balances(confirmed()));
  });
  it('UNKNOWN can also resolve to failure without point or NVDA consumption', () => {
    const s = resolveIntent(markUnknown(pending(),'i1'),'i1','failed',20n); invariant(s);
    expect(balances(s)).toMatchObject({nvdaSpent:0n,ethSpent:20n,pointsSpent:0,pointsReserved:0});
  });
  it('two rounds mature once and claim moves existing rewards without inflation', () => {
    let s = mature(); const r1=rewardAt(emissionAt(144).scheduled,emissionAt(144).target,9_000n,0n);
    expect(balances(s).claimableReward).toBe(r1);
    s=submitIntent(s,req('i2'));s=resolveIntent(s,'i2','success',65n);s=advanceRound(s,20_000n);
    const r2=rewardAt(emissionAt(145).scheduled,emissionAt(145).target,9_000n,20_000n);
    invariant(s); expect(balances(s).confirmedReward).toBe(r1+r2);
    s=claimRewards(s,'claim1',90n);invariant(s);
    expect(balances(s)).toMatchObject({nvdaSpent:18_020n,ethSpent:225n,ethReserved:100n,
      pointsSpent:2,claimedReward:r1+r2,claimableReward:0n,confirmedReward:r1+r2});
  });
  it('late final competition dilutes reward instead of locking preview result', () => {
    const low=advanceRound(confirmed(),0n);const high=advanceRound(confirmed(),10n**18n);
    expect(balances(high).confirmedReward).toBeLessThan(balances(low).confirmedReward);
    expect(balances(low).nvdaSpent).toBe(balances(high).nvdaSpent);
  });
  it('no mature rewards cannot incur a claim charge or consume claim ID', () => {
    const before=confirmed();const copy=structuredClone(before);
    try {const after=claimRewards(before,'later',30n);expect(balances(after)).toEqual(balances(before));}
    catch {expect(before).toEqual(copy);}
    const after=claimRewards(advanceRound(before,0n),'later',30n);
    expect(balances(after).claimedReward).toBeGreaterThan(0n);
  });
});

describe('PM independent replay and lifecycle', () => {
  it('repeated same submission is idempotent and conflicting payload rejected', () => {
    const s=pending();const again=submitIntent(s,req());expect(again).toEqual(s);invariant(again);
    expect(() => submitIntent(s,req('i1',{candidates:[cand({gasWei:99n})]}))).toThrow();
    expect(() => submitIntent(s,req('new-id'))).toThrow();
  });
  it('same resolution is idempotent, conflicting outcome or gas is rejected', () => {
    const s=confirmed();expect(resolveIntent(s,'i1','success',70n)).toEqual(s);
    expect(() => resolveIntent(s,'i1','failed',70n)).toThrow();
    expect(() => resolveIntent(s,'i1','success',69n)).toThrow();
  });
  it('same claim is idempotent and conflicting claim gas is rejected', () => {
    const s=claimRewards(mature(),'c1',20n);
    expect(claimRewards(s,'c1',20n)).toEqual(s);
    expect(() => claimRewards(s,'c1',21n)).toThrow();invariant(s);
  });
  it('one-intent-per-round includes failed intents', () => {
    const s=resolveIntent(pending(),'i1','failed',0n);
    expect(() => submitIntent(s,req('i2'))).toThrow();
  });
  it('pause stops new submission but lets pending result settle and claim mature rewards', () => {
    let s=pauseSimulation(pending());expect(s.status).toBe('PAUSED');
    expect(() => submitIntent(s,req('new'))).toThrow();
    s=resolveIntent(s,'i1','success',70n);s=advanceRound(s,0n);
    expect(s.status).toBe('PAUSED');s=claimRewards(s,'c1',20n);invariant(s);
    expect(resumeSimulation(s).status).toBe('RUNNING');
  });
  it('end preserves pending obligations and does not prevent settlement or claim', () => {
    let s=endSimulation(pending());expect(s.status).toBe('ENDED');invariant(s);
    expect(balances(s).nvdaReserved).toBe(10_010n);
    expect(() => submitIntent(s,req('new'))).toThrow();
    s=resolveIntent(s,'i1','success',70n);s=advanceRound(s,0n);s=claimRewards(s,'c1',20n);
    invariant(s);expect(s.status).toBe('ENDED');expect(balances(s).claimedReward).toBeGreaterThan(0n);
  });
  it('three elapsed rounds end the finite plan rather than granting three extra attempts', () => {
    let s=initial(); for(let i=0;i<3;i++){s=advanceRound(s,0n);invariant(s);}
    expect(s.round).toBe(147);expect(s.status).toBe('ENDED');
    expect(() => submitIntent(s,req('late'))).toThrow();
  });
  it('matured original intent is not matured again by another advance', () => {
    const s=mature();expect(balances(advanceRound(s,0n)).confirmedReward).toBe(balances(s).confirmedReward);
    expect(s.intents[0].originalRound).toBe(144);
  });
  it('WAIT decisions have no intent, cash, point, or reward charge', () => {
    const s=initial();const wait=submitIntent(s,req('waiting',{fx:null}));
    expect(wait.lastDecision?.action).toBe('WAIT');expect(wait.intents).toHaveLength(0);
    expect(balances(wait)).toEqual(balances(s));
  });
  it('SKIP on unit cost leaves balances and points unchanged', () => {
    const s=initial({costPerThousandCap:1n});const skip=submitIntent(s,req());
    expect(skip.lastDecision?.action).toBe('SKIP');expect(skip.intents).toHaveLength(0);
    expect(balances(skip)).toEqual(balances(s));
  });
});

describe('PM independent budget and hostile input checks', () => {
  it('exact balance boundary is allowed, one raw short never creates a pending intent', () => {
    const exact=submitIntent(initial({nvdaBudget:10_010n,ethBudget:240n}),req());invariant(exact);
    expect(exact.intents).toHaveLength(1);
    for(const delta of [{nvdaBudget:10_009n},{ethBudget:239n}]) {
      const s=initial({nvdaBudget:10_010n,ethBudget:240n,...delta});const copy=structuredClone(s);
      try{const r=submitIntent(s,req());expect(r.intents).toHaveLength(0);invariant(r);}catch{expect(s).toEqual(copy);}
    }
  });
  it('gas above reservation cannot settle, mutate input, or create a negative balance', () => {
    const s=pending();const before=structuredClone(s);
    expect(()=>resolveIntent(s,'i1','success',101n)).toThrow();
    expect(()=>resolveIntent(s,'i1','failed',101n)).toThrow();expect(s).toEqual(before);invariant(s);
  });
  it('claim can release own reserve but cannot consume exit reserve', () => {
    let s=submitIntent(initial({nvdaBudget:10_010n,ethBudget:240n}),req());
    s=resolveIntent(s,'i1','success',70n);s=advanceRound(s,0n);
    expect(()=>claimRewards(s,'over',71n)).toThrow();
    const good=claimRewards(s,'exact',70n);invariant(good);
    expect(balances(good)).toMatchObject({ethSpent:140n,ethReserved:100n,ethAvailable:0n});
  });
  it.each([0,4,1.5,NaN,Infinity])('rejects invalid maxRounds %s', (maxRounds)=>{
    expect(()=>createSimulation(conf({maxRounds}))).toThrow();
  });
  it.each([null,undefined,1,'1',-1n])('rejects non-bigint or negative initial NVDA %s', (nvdaBudget)=>{
    expect(()=>createSimulation(conf({nvdaBudget}))).toThrow();
  });
  it('rejects impossible initial exit reserve',()=>{
    expect(()=>createSimulation(conf({ethBudget:99n,ethExitReserve:100n}))).toThrow();
  });
  it('rejects sparse/null/undefined scenarios and candidates before creating any intent',()=>{
    for(const extra of [
      {otherWorkScenarios:new Array(1)}, {otherWorkScenarios:[0n,undefined]},
      {otherWorkScenarios:[null]}, {candidates:new Array(1)}, {candidates:[undefined]},
    ]) {const s=initial();const before=structuredClone(s);
      expect(()=>submitIntent(s,req('invalid',extra))).toThrow();expect(s).toEqual(before);}
  });
  it('rejects non-bigint gas and final Work and unknown outcomes',()=>{
    const s=pending();
    expect(()=>resolveIntent(s,'i1','success',1 as unknown as bigint)).toThrow();
    expect(()=>resolveIntent(s,'i1','succeeded' as 'success',70n)).toThrow();
    expect(()=>advanceRound(confirmed(),1 as unknown as bigint)).toThrow();
    expect(()=>claimRewards(mature(),'c1',-1n)).toThrow();
  });
  it('snapshots caller-owned configuration and intent candidates',()=>{
    const c=conf();const s=createSimulation(c);c.nvdaBudget=0n;
    expect(s.config.nvdaBudget).toBe(100_000n);
    const q=req();const submitted=submitIntent(startSimulation(s),q);q.candidates[0].paid=0n;
    const result=resolveIntent(submitted,'i1','success',70n);
    expect(balances(result).nvdaSpent).toBe(9_010n);invariant(result);
  });
  it('all normal operations leave their input state intact',()=>{
    const a=initial();const ac=structuredClone(a);const b=submitIntent(a,req());expect(a).toEqual(ac);
    const bc=structuredClone(b);const c=resolveIntent(b,'i1','success',70n);expect(b).toEqual(bc);
    const cc=structuredClone(c);const d=advanceRound(c,0n);expect(c).toEqual(cc);
    const dc=structuredClone(d);claimRewards(d,'c1',20n);expect(d).toEqual(dc);
  });
});
